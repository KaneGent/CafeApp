<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegisterActivity">

    <TextView
        android:id="@+id/RegisterPageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:text="Register Now"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/RegisterPageUsernameText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/RegisterPageUsernameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="1dp"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        app:layout_constraintBottom_toTopOf="@+id/RegisterPageUsernameTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/RegisterPageUsernameTextView"
        app:layout_constraintTop_toTopOf="@+id/RegisterPageUsernameTextView" />

    <EditText
        android:id="@+id/RegisterPagePhoneText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="1dp"
        android:ems="10"
        android:inputType="phone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/RegisterPagePhoneTextView"
        app:layout_constraintTop_toBottomOf="@+id/RegisterePageEmailTextView" />

    <EditText
        android:id="@+id/RegisterPagePasswordText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="1dp"
        android:ems="10"
        android:inputType="numberPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/RegisterPagePasswordTextView"
        app:layout_constraintTop_toBottomOf="@+id/RegisterPagePhoneText" />

    <EditText
        android:id="@+id/RegisterPageEmailText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="1dp"
        android:ems="10"
        android:inputType="textEmailAddress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/RegisterePageEmailTextView"
        app:layout_constraintTop_toBottomOf="@+id/RegisterPageUsernameText" />

    <TextView
        android:id="@+id/RegisterPageUsernameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="235dp"
        android:layout_marginEnd="1dp"
        android:text="Username"
        app:layout_constraintEnd_toStartOf="@+id/RegisterPageUsernameText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/RegisterePageEmailTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="7dp"
        android:text="Email"
        app:layout_constraintBottom_toBottomOf="@+id/RegisterPageEmailText"
        app:layout_constraintEnd_toStartOf="@+id/RegisterPageEmailText"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/RegisterPagePhoneTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="8dp"
        android:text="Ph Number"
        app:layout_constraintBottom_toBottomOf="@+id/RegisterPagePhoneText"
        app:layout_constraintEnd_toStartOf="@+id/RegisterPagePhoneText"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/RegisterPagePasswordTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="10dp"
        android:text="Set Password"
        app:layout_constraintBottom_toBottomOf="@+id/RegisterPagePasswordText"
        app:layout_constraintEnd_toStartOf="@+id/RegisterPagePasswordText"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/RegisterPageSaveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="104dp"
        android:text="Save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/RegisterPagePasswordText" />

</androidx.constraintlayout.widget.ConstraintLayout>